{
  "_note": "风格原型的 8 轴目标值。★ 重要：这些数字是**技法校准的起点估计**，不是语料统计结果。精确值应来自 `tools/analyze_style.py` 从你自己的参照样本文本反推。区间为 [下限, 上限]，单位见 _axes。",
  "_usage": {
    "工具": "tools/analyze_style.py --proto <id> 会用本文件的目标值做对比；--sample <文件> 反推真实指纹",
    "项目落点": "选定后写入 `主题/风格档.md`（模板 templates/style-profile.md）",
    "reference": "每份 skills/novel-style/reference/<file>.md 讲解该原型的**技法**，数值一律引用本文件，不要另抄一份"
  },
  "_axes": {
    "avg_sentence_len": {
      "name": "平均句长",
      "unit": "汉字/句",
      "axis": "1 句法节拍"
    },
    "sentence_len_sd": {
      "name": "句长标准差",
      "unit": "汉字",
      "axis": "1 句法节拍",
      "note": "越大=长短句错落"
    },
    "comma_per_kchar": {
      "name": "逗号密度",
      "unit": "个/千字",
      "axis": "1 句法节拍"
    },
    "dash_per_kchar": {
      "name": "破折号密度",
      "unit": "个/千字",
      "axis": "1 句法节拍"
    },
    "avg_para_len": {
      "name": "平均段长",
      "unit": "汉字/段",
      "axis": "1 句法节拍"
    },
    "simile_per_100": {
      "name": "比喻标记密度",
      "unit": "次/百字",
      "axis": "3 修辞密度",
      "note": "像/如/仿佛/似/如同/宛如/犹如"
    },
    "synesthesia_ratio": {
      "name": "通感句占比",
      "unit": "%",
      "axis": "3 修辞密度",
      "note": "同句含 ≥2 个感官通道"
    },
    "psych_ratio": {
      "name": "心理句占比",
      "unit": "%",
      "axis": "4 心理距离"
    },
    "internal_external": {
      "name": "内耗:外化",
      "unit": "比值",
      "axis": "4 心理距离",
      "note": "直接心理 ÷ 动作外化暗示"
    },
    "dialogue_ratio": {
      "name": "对话句占比",
      "unit": "%",
      "axis": "5 节奏呼吸"
    },
    "exclaim_per_kchar": {
      "name": "感叹号密度",
      "unit": "个/千字",
      "axis": "5 节奏呼吸"
    },
    "explicit_time_per_kchar": {
      "name": "显性时间标记密度",
      "unit": "个/千字",
      "axis": "6 叙事时间"
    },
    "first_person_ratio": {
      "name": "第一人称句占比",
      "unit": "%",
      "axis": "7 叙述者态度"
    },
    "essay_ratio": {
      "name": "议论句占比",
      "unit": "%",
      "axis": "7 叙述者态度",
      "note": "叙述者出面判断/总结"
    },
    "sense_priority": {
      "name": "感官优先通道",
      "unit": "通道名",
      "axis": "8 感官与留白"
    },
    "explain_per_kchar": {
      "name": "解释性连接词密度",
      "unit": "个/千字",
      "axis": "8 感官与留白",
      "note": "因为/所以/原来/其实/也就是 —— 越高=留白越少"
    },
    "ellipsis_per_kchar": {
      "name": "省略号密度",
      "unit": "个/千字",
      "axis": "8 感官与留白"
    },
    "colloquial_per_kchar": {
      "name": "口语标记密度",
      "unit": "个/千字",
      "axis": "2 词汇指纹",
      "note": "语气词/儿化/俗语 —— 市井类关键"
    },
    "jargon_per_kchar": {
      "name": "专名术语密度",
      "unit": "个/千字",
      "axis": "2 词汇指纹",
      "note": "拉丁字母串 + 中文构词后缀启发式（系统/协议/常数/方程/模型/机制/阈值…）；纯中文术语文本才算得出，属代理指标"
    },
    "meta_per_kchar": {
      "name": "元叙事标记密度",
      "unit": "个/千字",
      "axis": "2 词汇指纹",
      "note": "书中书/档案/注释 —— 智性类关键"
    }
  },
